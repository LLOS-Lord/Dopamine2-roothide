+#ifndef DOPAMINE_XPF_XPC_COMPAT_H
+#define DOPAMINE_XPF_XPC_COMPAT_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/mman.h>
+
+/*
+ * XPF only serializes offset dictionaries. The SDK XPC header marks some
+ * connection APIs unavailable on iOS, which is unrelated to these calls and
+ * breaks the broader BaseBin build when that header is visible.
+ */
+typedef void *xpc_object_t;
+
+xpc_object_t xpc_dictionary_create_empty(void);
+void xpc_dictionary_set_uint64(xpc_object_t dictionary, const char *key, uint64_t value);
+void xpc_release(xpc_object_t object);
+
+#endif
